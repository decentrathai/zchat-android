<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- File provider paths for ZCHAT data sharing (export, QR codes, etc.) -->

    <!-- Cache directory for QR code images and CSV exports -->
    <cache-path
        name="cache"
        path="."/>

    <!-- Files directory for general file sharing -->
    <files-path
        name="files"
        path="."/>

    <!-- External cache for downloaded APK updates -->
    <external-cache-path
        name="apk_updates"
        path="."/>

    <!-- no_backup directory for database export (root-path required, scoped to no_backup only) -->
    <root-path
        name="no_backup_store_release"
        path="/data/data/xyz.zsend.zchat/no_backup"/>
    <root-path
        name="no_backup_store_debug"
        path="/data/data/xyz.zsend.zchat.debug/no_backup"/>
    <root-path
        name="no_backup_foss_release"
        path="/data/data/xyz.zsend.zchat.foss/no_backup"/>
    <root-path
        name="no_backup_foss_debug"
        path="/data/data/xyz.zsend.zchat.foss.debug/no_backup"/>

    <!-- Testnet no_backup paths -->
    <root-path
        name="no_backup_testnet_store_release"
        path="/data/data/xyz.zsend.zchat.testnet/no_backup"/>
    <root-path
        name="no_backup_testnet_store_debug"
        path="/data/data/xyz.zsend.zchat.testnet.debug/no_backup"/>
    <root-path
        name="no_backup_testnet_foss_release"
        path="/data/data/xyz.zsend.zchat.testnet.foss/no_backup"/>
    <root-path
        name="no_backup_testnet_foss_debug"
        path="/data/data/xyz.zsend.zchat.testnet.foss.debug/no_backup"/>

    <!-- Legacy no_backup paths for backward compatibility -->
    <root-path
        name="no_backup_store_release_legacy"
        path="/data/data/co.electriccoin.zcash/no_backup"/>
    <root-path
        name="no_backup_store_debug_legacy"
        path="/data/data/co.electriccoin.zcash.debug/no_backup"/>
    <root-path
        name="no_backup_foss_release_legacy"
        path="/data/data/co.electriccoin.zcash.foss/no_backup"/>
    <root-path
        name="no_backup_foss_debug_legacy"
        path="/data/data/co.electriccoin.zcash.foss.debug/no_backup"/>
</paths>
