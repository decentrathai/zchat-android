    <string name="update_dialog_downloading">Downloading Update...</string>
    <string name="update_dialog_ready_title">Ready to Install</string>
    <string name="update_dialog_ready_body">If the installer didn\'t open, tap Install below.</string>
    <string name="update_dialog_install">Install</string>
    <string name="update_dialog_dismiss">Dismiss</string>
    <string name="update_dialog_failed_title">Update Failed</string>
    <string name="update_dialog_failed_unreachable">Could not reach update server. Check your connection.</string>
