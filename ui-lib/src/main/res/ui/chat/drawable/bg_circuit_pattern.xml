<?xml version="1.0" encoding="utf-8"?>
<!-- DEEP CYBER circuit board background pattern -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050510"/>
        </shape>
    </item>

    <!-- Circuit traces pattern using inset shapes -->
    <!-- Horizontal trace 1 -->
    <item android:top="40dp" android:left="0dp" android:right="200dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1820"/>
            <size android:height="1dp"/>
        </shape>
    </item>

    <!-- Horizontal trace 2 -->
    <item android:top="100dp" android:left="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1820"/>
            <size android:height="1dp"/>
        </shape>
    </item>

    <!-- Vertical trace 1 -->
    <item android:left="60dp" android:top="0dp" android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1820"/>
            <size android:width="1dp"/>
        </shape>
    </item>

    <!-- Vertical trace 2 -->
    <item android:left="200dp" android:top="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1820"/>
            <size android:width="1dp"/>
        </shape>
    </item>

    <!-- Node point 1 (cyan glow) -->
    <item android:left="58dp" android:top="38dp">
        <shape android:shape="oval">
            <solid android:color="#004040"/>
            <size android:width="5dp" android:height="5dp"/>
        </shape>
    </item>

    <!-- Node point 2 -->
    <item android:left="198dp" android:top="98dp">
        <shape android:shape="oval">
            <solid android:color="#004040"/>
            <size android:width="5dp" android:height="5dp"/>
        </shape>
    </item>

    <!-- Diagonal trace effect (lower right) -->
    <item android:left="250dp" android:top="160dp">
        <rotate android:fromDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="#081018"/>
                <size android:width="100dp" android:height="1dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>
