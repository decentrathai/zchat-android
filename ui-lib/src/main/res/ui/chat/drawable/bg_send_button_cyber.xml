<?xml version="1.0" encoding="utf-8"?>
<!-- DEEP CYBER send button with neon glow ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow (magenta) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#30FF00FF"/>
            <size android:width="52dp" android:height="52dp"/>
        </shape>
    </item>

    <!-- Magenta ring -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF00FF"/>
            <size android:width="48dp" android:height="48dp"/>
        </shape>
    </item>

    <!-- Inner cyan fill -->
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:centerColor="#00FFFF"
                android:endColor="#00BBBB"/>
            <size android:width="42dp" android:height="42dp"/>
        </shape>
    </item>
</layer-list>
