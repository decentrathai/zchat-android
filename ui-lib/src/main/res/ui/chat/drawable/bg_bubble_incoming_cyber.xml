<?xml version="1.0" encoding="utf-8"?>
<!-- DEEP CYBER incoming message bubble with angular edge and magenta accents -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow effect (outer magenta glow) -->
    <item android:left="0dp" android:right="0dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#15660044"/>
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="12dp"/>
        </shape>
    </item>

    <!-- Main bubble background (dark purple) -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1030"/>
            <stroke android:width="1dp" android:color="#40008080"/>
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="12dp"/>
        </shape>
    </item>

    <!-- Inner subtle gradient -->
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1E1438"
                android:endColor="#140E28"/>
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="10dp"
                android:bottomLeftRadius="3dp"
                android:bottomRightRadius="10dp"/>
        </shape>
    </item>
</layer-list>
