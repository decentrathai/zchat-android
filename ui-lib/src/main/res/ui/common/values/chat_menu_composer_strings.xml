    <string name="chat_mode_picker_title">Conversation mode</string>
    <string name="chat_mode_picker_apply">Apply</string>
    <string name="chat_mode_picker_cancel">Cancel</string>
    <string name="chat_mode_picker_desc_vault">Every message on-chain, at least 0.00017 ZEC each. The most private mode.</string>
    <string name="chat_mode_picker_desc_tunnel">2–3 on-chain payments, then free messages + voice through Nostr relays.</string>
    <string name="chat_mode_picker_desc_open">Free through Nostr relays from message #1 — texts and calls cost no ZEC. Needs the contact\'s chat key.</string>
    <string name="chat_mode_picker_open_needs_key">Needs your contact\'s chat key first: scan or paste their ZCHAT contact code, or switch to Tunnel to exchange it (costs ZEC; a contact on an older ZChat can\'t finish it until they update). Then Open becomes available.</string>

