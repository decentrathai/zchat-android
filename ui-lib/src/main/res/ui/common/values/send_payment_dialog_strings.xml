    <string name="send_payment_dialog_not_enough">Not enough that can go to others for this amount plus fees</string>
    <string name="send_payment_dialog_send">Send</string>
    <string name="send_payment_dialog_send_amount">Send %1$s ZEC</string>
    <string name="send_payment_dialog_cancel">Cancel</string>
