  The English text is the dialog's old literals byte for byte (the zero-amount button was "Send " with a trailing
  space; it is "Send" now). Figures are formatted in code with the phone's language.
-->
<resources>
    <string name="send_payment_dialog_title">Send Payment</string>
    <string name="send_payment_dialog_close">Close</string>
    <string name="send_payment_dialog_quick_pay">Quick Pay: %1$s</string>
