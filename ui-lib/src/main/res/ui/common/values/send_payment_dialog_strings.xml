    <string name="send_payment_dialog_can_send_to_others">Can send to others:</string>
    <!-- D-6: the exact fees of the typed amount and memo, from the SDK's price. %1$s = all fees, %2$s = the platform fee, %3$s = the network fee, in ZEC. -->
    <string name="send_payment_dialog_fees_exact">+ %1$s ZEC in fees (platform %2$s, network %3$s)</string>
    <!-- D-6: the same for a memo that needs several memo outputs; %4$s = the dust the extra memo outputs carry to the contact, in ZEC. -->
    <string name="send_payment_dialog_fees_exact_memos">+ %1$s ZEC in fees and extra memo outputs (platform %2$s, network %3$s, memo outputs %4$s)</string>
