    <string name="timelock_preset_1w">1w</string>

    <string name="timelock_block_title">Block Height Lock</string>
    <string name="timelock_block_note">Message is hidden until a specific Zcash block height. The timing is chain-verifiable, but the text itself is stored unencrypted in the on-chain memo.</string>
    <string name="timelock_current_block">Current block: #%1$d</string>
    <string name="timelock_blocks_label">Blocks</string>
