<!--
  Round 8 P9 (PHONE_TRIAGE ES-6) — the time-lock dialog (ChatDialogs.kt TimeLockComposerDialog and its lock settings).

  The four notes (timelock_*_note) are the dialog's old English byte for byte: they are where the user learns that a
  time-locked message is not encrypted. The durations are plurals now ("1 day", was "1 days").
-->
<resources>
    <string name="timelock_title">Time-Locked Message</string>
    <string name="timelock_close">Close</string>
    <string name="timelock_tab_schedule">Schedule</string>
