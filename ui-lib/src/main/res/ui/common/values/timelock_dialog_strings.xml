    <string name="timelock_message_placeholder">Write your time-locked message...</string>
    <string name="timelock_send">Send Locked Message</string>
    <string name="timelock_cancel">Cancel</string>

    <string name="timelock_schedule_title">Schedule Unlock</string>
    <string name="timelock_schedule_note">Message will automatically unlock after the specified time. Note: the message is hidden by the app, not encrypted — anyone reading the raw transaction can see it before then.</string>
    <string name="timelock_minutes_label">Minutes</string>
    <plurals name="timelock_duration_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
