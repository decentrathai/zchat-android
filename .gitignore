syntax: glob

# Build and intermediate files
build/
bin/
gen/
.gradle/
.DS_Store
local.properties
*.iml
*.hprof
*.apk
*.aab
*.keystore
*.jks
# Stray build/tooling artefacts. A pip download with no destination flag, run from
# the wrong directory, dropped 3 MB of Python wheels in the repo root on 2026-09-14.
# They were verified clean, but nothing in the tree or the hooks would have stopped
# `git add -A` from carrying them into a public release.
*.whl
*.tar.gz
*.zip

# IDE-specific files
.idea/AndroidProjectSystem.xml
.idea/androidTestResultsUserPreferences.xml
.idea/appInsightsSettings.xml
.idea/artifacts
.idea/assetWizardSettings.xml
.idea/caches
.idea/compiler.xml
.idea/csv-editor.xml
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml
.idea/dictionaries/
.idea/gradle.xml
.idea/inspectionProfiles/Project_Default.xml
.idea/kotlinc.xml
.idea/libraries/
.idea/material_theme_project_new.xml
.idea/migrations.xml
.idea/modules.xml
.idea/other.xml
.idea/project.prompts.xml
.idea/runConfigurations.xml
.idea/studiobot.xml
.idea/tasks.xml
.idea/vcs.xml
.idea/workspace.xml
.idea/deviceManager.xml
.idea/markdown.xml
.idea/ChatHistory_schema_v3.xml

# Other configuration files
google-services.json
.settings


.kotlin/
*.bak
.evidence/

# Secret files never go into the repo (owner spec 29 Sep 2026, secret & leak prevention item 8).
# tools/qa/secret_scan.py also reports these names as hard hits.
.env
*.env
*.p12
*.pem
*.mnemonic
*.seed
secrets*
*.dpapi
